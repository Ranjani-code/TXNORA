# Server
PORT=4000
APP_ORIGIN=http://localhost:5173
DATA_DIR=./server/data
UPLOAD_DIR=./server/uploads
MAX_UPLOAD_MB=10

# Gemini - server-side only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# PayPal Sandbox - server-side only
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_RETURN_URL=http://localhost:5173/paypal/return
PAYPAL_CANCEL_URL=http://localhost:5173/paypal/cancel

# Set false to start with an empty transaction list
SEED_STARTER_RECORDS=true

# Authentication: set a long random secret before using outside localhost
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
